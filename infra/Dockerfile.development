# syntax=docker/dockerfile:1
# Development image of the Admin. infra/dev-docker.sh builds and runs it.
# Nginx serves the static build on ADMIN_DEV_HOST:ADMIN_DEV_PORT and sends
# /api to ADMIN_API_TARGET, as the Vite development server does (Admin 038).
# The run gives the three variables and uses the host network.

FROM node:22.23.1-alpine3.24 AS build
WORKDIR /src
COPY package.json package-lock.json .npmrc ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY index.html tsconfig.json vite.config.ts ./
COPY public ./public
COPY src ./src
COPY docs/design-system/styles ./docs/design-system/styles
COPY docs/design-system/fonts ./docs/design-system/fonts
RUN npm run build

FROM nginx:1.31.8-alpine3.24
COPY infra/nginx.development.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /src/dist /usr/share/nginx/html
