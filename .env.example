# Environment configuration for the admin module.
# Add variables when their integration contract is defined.
# Variables prefixed with VITE_ are public browser values; never place secrets in them.

# Environment of this checkout. Always development locally; the ignored .env.local must have it.
ENV=development

# Development server (Admin 038). Server settings, never sent to the browser.
# Host the Vite dev server listens on.
ADMIN_DEV_HOST=127.0.0.1
# Port of the Vite dev server; the local Envoy reaches it there (backend infra/terraform, dev).
ADMIN_DEV_PORT=5173
# Origin the browser uses: the local Envoy serves the Admin there and routes /api/v1/ on it to the
# backend (Backend 071, 072). The backend ADMIN_ORIGIN must be this origin.
ADMIN_PUBLIC_ORIGIN=https://app.xokepoint.localhost
